# Copy to .env.local (local) or set in your hosting provider. All values optional.

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). GA4 loads only when set.
NEXT_PUBLIC_GA_ID=

# Google Search Console HTML-tag verification token (the content="" value only).
# The meta tag is rendered only when set.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# External sale / contact URL used by the domain banner and /domain CTA.
# If empty, the banner links to the internal /domain page and the CTA is hidden.
NEXT_PUBLIC_DOMAIN_SALE_URL=
